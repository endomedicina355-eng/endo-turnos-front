<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title>ENDO · Login Secretaría</title>
  <style>
    body{font-family:system-ui,-apple-system,Segoe UI,Roboto,Arial;margin:0;background:#f6f7f8;color:#111}
    .wrap{max-width:420px;margin:0 auto;padding:18px}
    .card{background:#fff;border:1px solid #e7e7e7;border-radius:14px;padding:16px;margin:12px 0}
    .brand{font-weight:900}
    .muted{color:#666;font-size:13px}
    input{width:100%;padding:10px 12px;border-radius:12px;border:1px solid #ddd;font-size:14px;margin-top:8px}
    button{width:100%;padding:12px 14px;border-radius:12px;border:0;background:#111;color:#fff;font-weight:800;cursor:pointer;margin-top:12px}
    .error{color:#b00020;font-size:13px;margin-top:10px}
    .ok{color:#0a7a27;font-size:13px;margin-top:10px}
  </style>
</head>
<body>
  <div class="wrap">
    <div class="card">
      <div class="brand">ENDO · Secretaría</div>
      <div class="muted">Ingresá con tu usuario</div>

      <input id="email" type="email" placeholder="Email" autocomplete="email"/>
      <input id="pass" type="password" placeholder="Contraseña" autocomplete="current-password"/>

      <button id="btn">Entrar</button>

      <div class="error" id="err"></div>
      <div class="ok" id="ok"></div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <script>
    const SUPABASE_URL = "https://qqfjvxspiyecuthislnq.supabase.co";
    const SUPABASE_ANON_KEY = "TU_ANON_KEY";
    const sb = supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

    const err = document.getElementById("err");
    const ok  = document.getElementById("ok");
    const btn = document.getElementById("btn");

    btn.onclick = async () => {
      err.textContent = ""; ok.textContent = "";
      btn.disabled = true;

      const email = document.getElementById("email").value.trim();
      const password = document.getElementById("pass").value;

      const { data, error } = await sb.auth.signInWithPassword({ email, password });

      if (error) {
        err.textContent = "Login inválido.";
        btn.disabled = false;
        return;
      }

      ok.textContent = "✅ OK, entrando…";
      window.location.href = "/secre_admin.html";
    };
  </script>
</body>
</html>
